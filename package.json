{
  "name": "nexus-horizon",
  "version": "1.0.0",
  "description": "Nexus Horizon - Next-Gen Connectivity Platform",
  "private": true,
  "scripts": {
    "start": "npm --prefix mobile run start",
    "dev:mobile": "npm --prefix mobile run start",
    "dev:server": "npm --prefix server run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:mobile\"",
    "build:mobile": "cd mobile && npx expo build",
    "build:server": "npm --prefix server run build",
    "build": "npm run build:server && npm run build:mobile",
    "start:server": "npm --prefix server run start",
    "start:mobile": "npm --prefix mobile run start"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.2.0",
    "nexus-horizon-expo-proxy": "file:tools/expo-proxy"
  }
}
